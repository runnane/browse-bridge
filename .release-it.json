{
  "git": {
    "commit": true,
    "commitMessage": "chore(release): v${version}",
    "tag": false,
    "push": false,
    "requireBranch": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": false
    }
  }
}
