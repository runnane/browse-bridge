{
  "name": "browse-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Tray app that bridges a remote agent host's browse relay to the local browser over SSH, with status, traffic counters and logs.",
  "type": "module",
  "main": "src/main.js",
  "author": {
    "name": "runnane",
    "url": "https://github.com/runnane"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "BB_FORBID_SSH=1 node --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "gates": "node scripts/check-syntax.js && BB_FORBID_SSH=1 node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage --publish never",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.1",
    "release-it": "^21.1.3"
  },
  "build": {
    "appId": "io.github.runnane.browse-bridge",
    "productName": "browse-bridge",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "browse-bridge-${arch}.AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "runnane",
      "repo": "browse-bridge",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
