{
  "name": "browse-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Tray app that bridges a remote agent host's browse relay to the local browser over SSH, with status, traffic counters and logs.",
  "type": "module",
  "main": "src/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "BB_FORBID_SSH=1 node --test test/",
    "check": "node scripts/check-syntax.js",
    "gates": "node scripts/check-syntax.js && BB_FORBID_SSH=1 node --test test/"
  },
  "devDependencies": {
    "electron": "45.3.4"
  }
}
